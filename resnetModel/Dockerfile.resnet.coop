FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
RUN pip3 install --no-cache-dir \
    tensorflow==2.14.1 \
    requests \
    numpy

# Copy cooperative client (THIS is the file that matters)
COPY resnet_client.py /app/resnet_client.py

ENTRYPOINT ["python3", "/app/resnet_client.py"]
